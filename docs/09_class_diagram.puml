@startuml
!define fg #003366
!define bg #ffffff
!define link #6699cc

'-- Layout configuration --
skinparam backgroundColor #ffffff
skinparam monochrome true
skinparam shadowing false
skinparam handwritten false
skinparam classAttributeIconSize 0

'-- User Class --
class User {
    +int user_id
    +str username
    +str email
    -str password
    +str full_name
    +str phone_number
    +str profile_picture
    +datetime created_at
    +datetime last_login
    +bool is_active
}

'-- JadwalSholat Class --
class JadwalSholat {
    +int schedule_id
    +int user_id
    +date tanggal
    +time subuh
    +time dzuhur
    +time ashar
    +time maghrib
    +time isya
    +timedelta waktu_selisih
}

'-- PengingatSholat Class --
class PengingatSholat {
    +int reminder_id
    +int user_id
    +time waktu_pengingat
    +int menit_sebelum
    +bool status_aktif
    +str tipe
}

'-- Lokasi Class --
class Lokasi {
    +int lokasi_id
    +int user_id
    +float latitude
    +float longitude
    +float akurasi
    +datetime waktu_deteksi
    +datetime terakhir_update
}

'-- Kiblat Class --
class Kiblat {
    +int kiblat_id
    +int user_id
    +float sudut_kiblat
    +tuple koordinat_kaaba
    +str metode_hitung
}

'-- Wirid Class --
class Wirid {
    +int wirid_id
    +str judul
    +str teks_arab
    +str teks_latin
    +str terjemahan
    +str kategori
    +datetime created_at
}

'-- Dzikir Class --
class Dzikir {
    +int dzikir_id
    +int user_id
    +str jenis_dzikir
    +int jumlah_ulang
    +int jumlah_saat_ini
    +datetime last_reminder
}

'-- RiwayatDzikir Class --
class RiwayatDzikir {
    +int riwayat_id
    +int user_id
    +date tanggal
    +datetime waktu_mulai
    +datetime waktu_selesai
    +str jenis_dzikir
    +int jumlah_ulang
}

'-- Doa Class --
class Doa {
    +int doa_id
    +str judul
    +str teks_arab
    +str teks_latin
    +str terjemahan
    +str kategori
    +bool is_favorit
}

'-- KategoriDoa Class --
class KategoriDoa {
    +int kategori_id
    +str nama_kategori
    +str deskripsi
    +str warna_tampilan
}

'-- Surah Class --
class Surah {
    +int surah_id
    +int nomor
    +str nama
    +str nama_latin
    +int jumlah_ayat
    +str tempat_turun
    +str arti_ringkas
}

'-- Murottal Class --
class Murottal {
    +int murottal_id
    +int surah_id
    +str nama_reciter
    +time durasi
    +str path_audio
    +bool is_favorite
}

'-- Pengaturan Class --
class Pengaturan {
    +int setting_id
    +int user_id
    +str tema
    +str bahasa
    +bool notifikasi
    +bool suhbat
    +bool musik_murottal
}

'-- Relasi Association --
User *-- JadwalSholat : "memiliki"
User *-- PengingatSholat : "memiliki"
User *-- Lokasi : "dimiliki"
User *-- Kiblat : "terkait"
User *-- Wirid : "mengakses"
User *-- Dzikir : "miliki"
User *-- RiwayatDzikir : "catat"
User *-- Doa : "akses"
User *-- KategoriDoa : "gunakan"
User *-- Surah : "membaca"
User *-- Murottal : "dengarkan"
User *-- Pengaturan : "miliki"

'-- Relasi ke class non-User --
JadwalSholat *-- User : "1"
PengingatSholat *-- User : "1"
Lokasi *-- User : "1"
Kiblat *-- User : "1"
Dzikir *-- User : "1"
RiwayatDzikir *-- User : "1"
Doa *-- KategoriDoa : "kategorikan"
Surah *-- Murottal : "dilengkapi"
Murottal *-- Surah : "tersedia"

'-- Relasi Aggregation/Composition note --
note right of User "Aktor utama: bisa memiliki banyak data terkait" end note

note right of KategoriDoa "Mendukung fitur pencarian doa" end note
note right of Murottal "Memiliki fitur play/pause/stop" end note

@enduml